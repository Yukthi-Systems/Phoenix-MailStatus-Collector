# /etc/mailstatus-collector/env  (mode 0600, owner root)
# Loaded by mailstatus-collector.service.
# All variables are documented in README.md, "Configuration".

# --- RabbitMQ -----------------------------------------------------------------
# Replace both CHANGE_ME values. The queue must already exist.
MAILSTATUS_RABBITMQ_URL=amqp://USER:CHANGE_ME@RABBITMQ_HOST:5672/VHOST
# With the default exchange: the queue name.
MAILSTATUS_RABBITMQ_ROUTING_KEY=CHANGE_ME
# MAILSTATUS_RABBITMQ_EXCHANGE=          # empty: the default exchange
# MAILSTATUS_LOG_TYPE=Outgoing           # "type" in the JSON body
# MAILSTATUS_TIME_ZONE=Asia/Kolkata      # zone of the timestamps; UTC for +00:00
# AMQP header "type", for consumers that route on it. Empty: no header.
# MAILSTATUS_RABBITMQ_HEADER_TYPE=fuglu

# --- What is recorded -----------------------------------------------------------
# Header that fills "euid". Must match /etc/postfix/header_checks.
MAILSTATUS_REFERENCE_HEADER=X-YSPL-ID
# Next hops that re-queue mail on this Postfix, such as a DKIM-signing content
# filter (host names as in relay=, comma-separated). Only the outgoing delivery
# is then published. Leave it commented out on a server without such a filter.
# MAILSTATUS_INTERNAL_RELAYS=dkim-filter.example.net
# error_code for "Delivered".
MAILSTATUS_SUCCESS_CODE=250

# --- This server ---------------------------------------------------------------
# Unique name of this mail server (default: hostname). It is part of every event
# ID, so never change it once the server has published.
# MAILSTATUS_NODE=mx1.example.net

# --- Tuning (defaults shown) ----------------------------------------------------
# MAILSTATUS_BATCH_SIZE=500
# MAILSTATUS_FLUSH_INTERVAL=1s
# MAILSTATUS_STATS_INTERVAL=5m
# MAILSTATUS_STATE_MAX_AGE=720h          # longer than Postfix maximal_queue_lifetime
# MAILSTATUS_LOG_LEVEL=info              # debug | info | warn | error
# MAILSTATUS_LOG_FORMAT=json             # json | text (logfmt)
# The systemd unit sets MAILSTATUS_LOG_FILE=/var/log/mailstatus-collector/collector.log
# and MAILSTATUS_STATE_FILE=/var/lib/mailstatus-collector/state.json.
# MAILSTATUS_LOG_MAX_SIZE_MB=100         # rotate at this size
# MAILSTATUS_LOG_MAX_FILES=10            # rotated files kept
# MAILSTATUS_LOG_MAX_AGE=720h            # rotated files older than this are removed
# MAILSTATUS_LOG_COMPRESS=true           # gzip rotated files
# MAILSTATUS_POSTFIX_SYSLOG_NAME=postfix  # Postfix syslog_name (multi-instance: postfix-out)
# MAILSTATUS_POSTFIX_SERVICES=cleanup,qmgr,smtp,lmtp,local,virtual,pipe,error,discard
# MAILSTATUS_JOURNALCTL=journalctl
